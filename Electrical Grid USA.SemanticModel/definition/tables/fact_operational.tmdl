table fact_operational
	lineageTag: 74145ac4-3052-4313-8d97-91fe7ff81f6c

	measure 'Total Net Generation MWh' = ```
			
			SUM ( fact_operational[net_generation_mwh] )
			
			```
		lineageTag: ca4fac22-6f53-473e-93c3-6410e184856a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Sources MWh' = ```
			
			SUM ( fact_operational[total_sources_mwh] )
			
			```
		lineageTag: 43ebef1d-7933-474e-b04b-86f3786b9216

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Energy Losses MWh' = ```
			
			SUM ( fact_operational[total_energy_losses_mwh] )
			
			```
		lineageTag: a9354295-2f9e-426c-a4ce-8d8f86371e3c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Wholesale Purchases MWh' = ```
			
			SUM ( fact_operational[wholesale_purchases_mwh] )
			
			```
		lineageTag: 1ca9d66f-dd9b-4b86-8b9a-f826d84d631c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Loss Rate %' = ```
			
			DIVIDE ( [Total Energy Losses MWh], [Total Sources MWh], 0 )
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: f4cbaaeb-e544-4035-949f-313ac967c709

	measure 'Purchase Dependency %' = ```
			
			DIVIDE ( [Total Wholesale Purchases MWh], [Total Sources MWh], 0 )
			
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 803e7916-a6c4-42a5-bcdd-705ab13217b4

	measure 'Self Sufficiency Index' = ```
			
			DIVIDE ( [Total Net Generation MWh], [Total Sources MWh], 0 )
			
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: c643ace1-a6eb-4b60-b8e3-975548c38fe3

	measure 'Summer Peak Demand MW' = ```
			
			SUM ( fact_operational[summer_peak_demand_mw] )
			
			```
		lineageTag: 0d5190c8-be5b-4ced-8ad3-6b2d2275a9ad

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Winter Peak Demand MW' = ```
			
			SUM ( fact_operational[winter_peak_demand_mw] )
			
			```
		lineageTag: a29b08ed-3b11-4e69-a746-1403188cca8d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Supply Vulnerability Score' = ```
			
			ROUND ( ( [Purchase Dependency %] * 0.6 + [Loss Rate %] * 0.4 ) * 100, 1 )
			
			```
		lineageTag: 1998d14d-10a2-41a2-a15b-4592b7d45ade

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Load Imbalance Score' = ```
			
			DIVIDE (
			    ABS ( [Summer Peak Demand MW] - [Winter Peak Demand MW] ),
			    ( [Summer Peak Demand MW] + [Winter Peak Demand MW] ) / 2,
			    0
			) * 100
			
			```
		lineageTag: 2ae81d66-007d-43f4-88f4-debf4e8928c7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Loss Rate Risk Flag' = ```
			
			IF ( [Loss Rate %] > 0.08, "HIGH RISK",
			    IF ( [Loss Rate %] > 0.05, "ELEVATED", "NORMAL" ) )
			
			```
		lineageTag: a030dbb5-4c8d-443a-8286-113928863743

