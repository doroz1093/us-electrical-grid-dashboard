table fact_reliability
	lineageTag: 0c1534d9-866e-44c2-8736-663715545b66

	measure 'Weighted Avg SAIDI All' = ```
			
			VAR _rows = FILTER ( fact_reliability, NOT ISBLANK ( fact_reliability[ieee_saidi_all] ) && NOT ISBLANK ( fact_reliability[ieee_num_customers] ) )
			RETURN DIVIDE ( SUMX ( _rows, fact_reliability[ieee_saidi_all] * fact_reliability[ieee_num_customers] ), SUMX ( _rows, fact_reliability[ieee_num_customers] ) )
			
			```
		lineageTag: ca4ff6b7-c8ec-4be8-b671-7e6e56a2c6c8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Weighted Avg SAIDI No MED' = ```
			
			VAR _rows = FILTER ( fact_reliability, NOT ISBLANK ( fact_reliability[ieee_saidi_no_med] ) && NOT ISBLANK ( fact_reliability[ieee_num_customers] ) )
			RETURN DIVIDE ( SUMX ( _rows, fact_reliability[ieee_saidi_no_med] * fact_reliability[ieee_num_customers] ), SUMX ( _rows, fact_reliability[ieee_num_customers] ) )
			
			```
		lineageTag: ea9340ea-4388-426b-b6c3-ea87022c259e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Weighted Avg SAIFI All' = ```
			
			VAR _rows = FILTER ( fact_reliability, NOT ISBLANK ( fact_reliability[ieee_saifi_all] ) && NOT ISBLANK ( fact_reliability[ieee_num_customers] ) )
			RETURN DIVIDE ( SUMX ( _rows, fact_reliability[ieee_saifi_all] * fact_reliability[ieee_num_customers] ), SUMX ( _rows, fact_reliability[ieee_num_customers] ) )
			
			```
		lineageTag: e3931b85-c2e4-44a0-8239-3fec772bc635

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Weighted Avg CAIDI All' = ```
			
			DIVIDE ( [Weighted Avg SAIDI All], [Weighted Avg SAIFI All], BLANK() )
			
			```
		lineageTag: 2cd150f0-ab23-4aad-a056-545cea9d86b4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Storm Impact Index (min)' = ```
			
			[Weighted Avg SAIDI All] - [Weighted Avg SAIDI No MED]
			
			```
		lineageTag: df58e4da-5797-4294-a390-b8bc91c03c70

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Grid Stability Score' = ```
			
			// 0-100 score on controllable reliability: customer-weighted SAIDI excluding major event days.
			// 0 min = 100 points, 500 min or more = 0 points. Storms are measured separately (Storm Impact Index).
			VAR ceilingMinutes = 500
			VAR saidi = [Weighted Avg SAIDI No MED]
			RETURN IF ( ISBLANK ( saidi ), BLANK (), MAX ( 0, ( 1 - saidi / ceilingMinutes ) * 100 ) )
			
			```
		lineageTag: 91c4d51b-714f-4104-8fa6-7d879313378c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Customers Reliability' = ```
			
			SUM ( fact_reliability[ieee_num_customers] )
			
			```
		formatString: 0
		lineageTag: 3efc14b8-b372-463e-ace0-f29b5eea8b7b

	measure 'Customers Served' =
			
			SUM(fact_reliability[other_num_customers])
		formatString: 0
		lineageTag: 6d273024-d592-4306-8c3c-cee0861878cd

