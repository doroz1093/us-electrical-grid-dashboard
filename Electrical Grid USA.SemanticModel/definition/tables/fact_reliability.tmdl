	partition fact_reliability = m
		mode: import
		source =
				let
				    // EIA-861 reliability file read with proper CSV quoting. The SQL copy of this table was loaded with
				    // commas inside quoted values split into extra columns (e.g. "Northern Lights, Inc" and "39,641"),
				    // which shifted 136 rows and wiped customer counts. Reading the source file directly avoids that.
				    Source = Csv.Document(File.Contents("C:\Users\doroz\OneDrive\Desktop\Projects\Electrical Grid\Raw Data\Reliability_2024.csv"), [Delimiter=",", Columns=28, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    DataRows = Table.Skip(Source, 3),
				    Renamed = Table.RenameColumns(DataRows, List.Zip({Table.ColumnNames(DataRows), {"data_year", "utility_number", "utility_name", "state", "ownership_type", "ieee_saidi_all", "ieee_saifi_all", "ieee_caidi_all", "ieee_saidi_no_med", "ieee_saifi_no_med", "ieee_caidi_no_med", "ieee_saidi_los", "ieee_saifi_los", "ieee_caidi_los", "ieee_num_customers", "ieee_highest_voltage", "ieee_auto_outages", "other_saidi_all", "other_saifi_all", "other_caidi_all", "other_saidi_no_med", "other_saifi_no_med", "other_caidi_no_med", "other_num_customers", "other_inactive_accts", "other_momentary", "other_highest_voltage", "other_auto_outages"}})),
				    Trimmed = Table.TransformColumns(Renamed, {}, Text.Trim),
				    DotsToNull = Table.ReplaceValue(Trimmed, ".", null, Replacer.ReplaceValue, Table.ColumnNames(Trimmed)),
				    BlanksToNull0 = Table.ReplaceValue(DotsToNull, "", null, Replacer.ReplaceValue, Table.ColumnNames(DotsToNull)),
				    BlanksToNull = Table.SelectRows(BlanksToNull0, each [data_year] <> null and Text.Length([data_year]) = 4 and Text.Length([state] ?? "") = 2),
				    NoThousands = Table.TransformColumns(BlanksToNull, List.Transform({"data_year", "utility_number", "ieee_num_customers", "other_num_customers", "ieee_saidi_all", "ieee_saifi_all", "ieee_caidi_all", "ieee_saidi_no_med", "ieee_saifi_no_med", "ieee_caidi_no_med", "ieee_saidi_los", "ieee_saifi_los", "ieee_caidi_los", "ieee_highest_voltage", "other_saidi_all", "other_saifi_all", "other_caidi_all", "other_saidi_no_med", "other_saifi_no_med", "other_caidi_no_med", "other_highest_voltage"}, (c) => {c, each if _ = null then null else Text.Remove(_, ","), type nullable text})),
				    Typed = Table.TransformColumnTypes(NoThousands, {{"data_year", Int64.Type}, {"utility_number", Int64.Type}, {"ieee_num_customers", Int64.Type}, {"other_num_customers", Int64.Type}, {"ieee_saidi_all", type number}, {"ieee_saifi_all", type number}, {"ieee_caidi_all", type number}, {"ieee_saidi_no_med", type number}, {"ieee_saifi_no_med", type number}, {"ieee_caidi_no_med", type number}, {"ieee_saidi_los", type number}, {"ieee_saifi_los", type number}, {"ieee_caidi_los", type number}, {"ieee_highest_voltage", type number}, {"other_saidi_all", type number}, {"other_saifi_all", type number}, {"other_caidi_all", type number}, {"other_saidi_no_med", type number}, {"other_saifi_no_med", type number}, {"other_caidi_no_med", type number}, {"other_highest_voltage", type number}, {"utility_name", type text}, {"state", type text}, {"ownership_type", type text}, {"ieee_auto_outages", type text}, {"other_inactive_accts", type text}, {"other_momentary", type text}, {"other_auto_outages", type text}}, "en-US"),
				    NoErrors = Table.ReplaceErrorValues(Typed, List.Transform(Table.ColumnNames(Typed), each {_, null})),
				    Indexed = Table.AddIndexColumn(NoErrors, "rel_id", 1, 1, Int64.Type),
				    Result = Table.ReorderColumns(Indexed, {"rel_id", "data_year", "utility_number", "utility_name", "state", "ownership_type", "ieee_saidi_all", "ieee_saifi_all", "ieee_caidi_all", "ieee_saidi_no_med", "ieee_saifi_no_med", "ieee_caidi_no_med", "ieee_saidi_los", "ieee_saifi_los", "ieee_caidi_los", "ieee_num_customers", "ieee_highest_voltage", "ieee_auto_outages", "other_saidi_all", "other_saifi_all", "other_caidi_all", "other_saidi_no_med", "other_saifi_no_med", "other_caidi_no_med", "other_num_customers", "other_inactive_accts", "other_momentary", "other_highest_voltage", "other_auto_outages"})
				in
				    Result

	annotation PBI_ResultType = Table

