table vw_state_energy_summary
	lineageTag: 44b8c721-6452-48a6-a574-c90ff363da96

	measure 'Total Revenue $ (Regional)' =
			
			SUMX(vw_state_energy_summary, vw_state_energy_summary[total_revenue_000] * 1000)
		lineageTag: e65b8618-d78e-436e-9444-1e699f8b6894

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Revenue per MWh (Regional)' =
			
			DIVIDE(
			    SUMX(vw_state_energy_summary, vw_state_energy_summary[total_revenue_000] * 1000),
			    SUM(vw_state_energy_summary[total_sales_mwh]),
			    0
			)
		lineageTag: 45ef1140-f010-4911-99e2-c643794485f0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Customers (Regional)' =
			
			SUM(vw_revenue_efficiency[total_customers])
		formatString: 0
		lineageTag: 73a36893-af26-44a3-9d28-be3b852a6214

	measure 'Revenue per Customer (Regional)' =
			
			DIVIDE(
			    SUMX(vw_state_energy_summary, vw_state_energy_summary[total_revenue_000] * 1000),
			    SUM(vw_revenue_efficiency[total_customers]),
			    0
			)
		lineageTag: 17cd1193-9672-431c-a84e-f15e663f33d9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Industrial Revenue Share % (Regional)' =
			
			DIVIDE(
			    SUM(vw_utility_sales_by_sector[industrial_revenue_000]),
			    SUM(vw_utility_sales_by_sector[industrial_revenue_000])
			        + SUM(vw_utility_sales_by_sector[commercial_revenue_000])
			        + SUM(vw_utility_sales_by_sector[residential_revenue_000]),
			    0
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: d642b0de-6169-469c-8a4d-b82f6d6aa9f9

	measure 'Industry Risk (Regional)' =
			
			IF([Industrial Revenue Share % (Regional)] > 0.35, "HIGH RISK",
			IF([Industrial Revenue Share % (Regional)] > 0.25, "MODERATE", "HEALTHY"))
		lineageTag: 7947bad7-1e69-4948-a6ea-3a35715a3d4d

